{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Kisaki Extension",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/extensions/${input:extensionId}",
      "runtimeExecutable": "pnpm",
      "windows": {
        "runtimeExecutable": "pnpm.cmd"
      },
      "runtimeArgs": ["run", "dev"],
      "autoAttachChildProcesses": true,
      "console": "internalConsole",
      "outputCapture": "std",
      "internalConsoleOptions": "openOnSessionStart"
    }
  ],
  "inputs": [
    {
      "id": "extensionId",
      "type": "promptString",
      "description": "Extension ID to run",
      "default": "{{EXTENSION_ID}}"
    }
  ]
}
