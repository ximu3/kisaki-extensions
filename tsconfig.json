{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [".github/scripts/**/*.ts", "tools/**/*.ts", "eslint.config.ts"]
}
